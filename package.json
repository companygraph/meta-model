{
  "name": "companygraph-meta-model",
  "version": "0.80.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["lib", "bin", "types/lib", "core", "form", "packs", "agents"],
  "bin": { "companygraph": "./bin/companygraph.mjs" },
  "exports": {
    "./ids": { "types": "./types/lib/ids.d.mts", "default": "./lib/ids.mjs" },
    "./instance": { "types": "./types/lib/instance.d.mts", "default": "./lib/instance.mjs" },
    "./checks": { "types": "./types/lib/checks.d.mts", "default": "./lib/checks.mjs" },
    "./plan": { "types": "./types/lib/plan.d.mts", "default": "./lib/plan.mjs" },
    "./write": { "types": "./types/lib/write.d.mts", "default": "./lib/write.mjs" },
    "./obsidian": { "types": "./types/lib/obsidian.d.mts", "default": "./lib/obsidian.mjs" },
    "./localization": { "types": "./types/lib/localization.d.mts", "default": "./lib/localization.mjs" },
    "./questions": { "types": "./types/lib/questions.d.mts", "default": "./lib/questions.mjs" }
  },
  "scripts": {
    "build": "tsc",
    "build:check": "node tools/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node verify/check.mjs",
    "test:instance": "node --test verify/instance.test.mjs verify/constraints.test.mjs verify/pack-parse.test.mjs",
    "test:instance-checks": "node --test verify/instance-checks.test.mjs verify/declared-joins.test.mjs verify/list-kind.test.mjs verify/image.test.mjs verify/ref-by.test.mjs verify/kpi.test.mjs verify/brand.test.mjs verify/decision.test.mjs verify/question-kind.test.mjs verify/references.test.mjs verify/identifier.test.mjs verify/localization-file.test.mjs verify/packs.test.mjs verify/software.test.mjs verify/rule-risk-control.test.mjs verify/checks-owed.test.mjs verify/processors-and-stored-items.test.mjs",
    "test:instance-files": "node --test verify/instance-files.test.mjs",
    "test:form": "node --test verify/form.test.mjs",
    "test:pins": "node --test verify/pins.test.mjs",
    "test:ids": "node --test verify/ids.test.mjs verify/change-checks.test.mjs",
    "test:localization": "node --test verify/localization.test.mjs",
    "test:plan": "node --test verify/plan.test.mjs",
    "test:rules": "node --test verify/rule-citations.test.mjs",
    "test:cli": "node --test verify/cli.test.mjs",
    "test:consumer": "node --test verify/consumer.test.mjs",
    "test:untar":"node --test verify/untar.test.mjs",
    "test:fetch-core": "node --test verify/fetch-core.test.mjs",
    "test:obsidian": "node --test verify/obsidian.test.mjs",
    "test:judge": "node --test verify/questions.test.mjs verify/judge.test.mjs verify/judge-faults.test.mjs verify/known.test.mjs",
    "test:seats": "node --test verify/seats.test.mjs verify/history.test.mjs verify/commits.test.mjs"
  },
  "devDependencies": { "@types/node": "22.20.4", "markdownlint-cli2": "0.23.2", "typescript": "7.0.2" }
}
