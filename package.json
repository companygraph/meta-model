{
  "name": "companygraph-meta-model",
  "version": "0.64.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["lib", "bin", "core", "agents"],
  "bin": { "companygraph": "./bin/companygraph.mjs" },
  "exports": {
    "./instance": { "types": "./lib/instance.d.mts", "default": "./lib/instance.mjs" },
    "./checks": { "types": "./lib/checks.d.mts", "default": "./lib/checks.mjs" },
    "./plan": { "types": "./lib/plan.d.mts", "default": "./lib/plan.mjs" },
    "./write": { "types": "./lib/write.d.mts", "default": "./lib/write.mjs" },
    "./obsidian": { "types": "./lib/obsidian.d.mts", "default": "./lib/obsidian.mjs" }
  },
  "scripts": {
    "build": "tsc",
    "build:check": "node tools/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node verify/check.mjs",
    "test:instance": "node --test verify/instance.test.mjs verify/constraints.test.mjs",
    "test:instance-checks": "node --test verify/instance-checks.test.mjs verify/declared-joins.test.mjs verify/list-kind.test.mjs verify/image.test.mjs verify/ref-by.test.mjs verify/kpi.test.mjs verify/brand.test.mjs verify/decision.test.mjs verify/question-kind.test.mjs verify/references.test.mjs",
    "test:instance-files": "node --test verify/instance-files.test.mjs",
    "test:plan": "node --test verify/plan.test.mjs",
    "test:rules": "node --test verify/rule-citations.test.mjs",
    "test:cli": "node --test verify/cli.test.mjs",
    "test:untar": "node --test verify/untar.test.mjs",
    "test:fetch-core": "node --test verify/fetch-core.test.mjs",
    "test:obsidian": "node --test verify/obsidian.test.mjs",
    "test:seats": "node --test verify/seats.test.mjs verify/history.test.mjs verify/commits.test.mjs"
  },
  "devDependencies": { "@types/node": "22.20.4", "typescript": "7.0.2" }
}
